<?xml version="1.0"?>
<ruleset name="Lingolane">
	<description>Lingolane coding standards: security, i18n, database safety and PHP 7.4+ compatibility.</description>

	<file>lingolane</file>
	<exclude-pattern>*/languages/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<config name="minimum_supported_wp_version" value="6.2"/>
	<config name="testVersion" value="7.4-"/>

	<!-- Runs on every supported PHP version. -->
	<rule ref="PHPCompatibilityWP"/>

	<!-- Escaping, nonces, capability and input handling. -->
	<rule ref="WordPress.Security"/>

	<!-- Every user-facing string uses the lingolane text domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="lingolane"/>
			</property>
		</properties>
	</rule>

	<!--
		SQL must go through $wpdb->prepare(): NotPrepared stays an error.
		InterpolatedNotPrepared / UnfinishedPrepare only flag table names and %s placeholder lists built from
		$wpdb->prefix, literals and integers (identifiers cannot be bound), so they are reported as warnings.
	-->
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQL.InterpolatedNotPrepared">
		<type>warning</type>
	</rule>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders.UnfinishedPrepare">
		<type>warning</type>
	</rule>

	<!--
		Lingolane reads and writes its own tables (translation links, string catalog) that have no WordPress API.
		Direct queries are therefore expected, and results are cached by Lingolane_Elements / Lingolane_Strings
		(object cache + transients), so these two sniffs are intentionally off.
	-->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
		<exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
	</rule>

	<!-- Global names must carry the plugin prefix. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="lingolane"/>
			</property>
		</properties>
		<!-- The pre-release "tml_" compatibility layer keeps its old names on purpose and is not shipped to WordPress.org. -->
		<exclude-pattern>*/includes/compat-legacy.php</exclude-pattern>
	</rule>
</ruleset>
