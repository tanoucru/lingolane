msgstr "Đã lưu"

msgid "Could not save. Please try again."
msgstr "Không lưu được. Thử lại."

msgid "Not saved"
msgstr "Chưa lưu"

msgid "Remove this string from the list? Its saved translations are deleted as well."
msgstr "Xoá chuỗi này khỏi danh sách? Bản dịch đã lưu của chuỗi cũng bị xoá."

msgid "You have unsaved translations. Leave this page?"
msgstr "Có bản dịch chưa lưu. Rời trang?"

msgid "The selected language is not in the list."
msgstr "Ngôn ngữ đã chọn không có trong danh sách."

msgid "%s is now the default language. Its pages no longer have a prefix in their URLs."
msgstr "%s là ngôn ngữ mặc định. Trang của ngôn ngữ này giờ không có tiền tố trong đường dẫn."

msgid "The language code is 2–3 lowercase letters, optionally with a region (for example ja, fr, zh-tw)."
msgstr "Mã ngôn ngữ gồm 2–3 chữ cái thường, có thể thêm vùng (ví dụ: ja, fr, zh-tw)."

msgid "A display name and a valid WordPress locale are required (for example fr_FR, ja)."
msgstr "Cần tên hiển thị và locale WordPress hợp lệ (ví dụ: fr_FR, ja)."

msgid "The code “%s” is already in the list."
msgstr "Mã “%s” đã có trong danh sách."

msgid "Added %1$s. Its pages have URLs starting with %2$s; create translations in the Posts & pages tab."
msgstr "Đã thêm %1$s. Trang của ngôn ngữ này có địa chỉ bắt đầu bằng %2$s; tạo bản dịch ở tab Bài & trang."

msgid "Updated %s."
msgstr "Đã cập nhật %s."

msgid "You cannot remove the default language or the content’s source language."
msgstr "Không thể xoá ngôn ngữ mặc định hoặc ngôn ngữ gốc của nội dung."

msgid "This language still has %1$d linked items and %2$d translated strings. Delete or move those translations first so no data is lost."
msgstr "Ngôn ngữ này còn %1$d nội dung liên kết và %2$d chuỗi đã dịch. Xoá hoặc chuyển các bản dịch đó trước để không mất dữ liệu."

msgid "Removed %s from the site."
msgstr "Đã gỡ %s khỏi website."

msgid "Select at least one content type to translate. No changes were saved."
msgstr "Chọn ít nhất một loại nội dung cần dịch. Chưa có thay đổi nào được lưu."

msgid "Settings saved."
msgstr "Đã lưu cài đặt."

msgid "Cache cleared. The latest translations will show on the next page load."
msgstr "Đã làm mới bộ nhớ đệm. Bản dịch mới nhất sẽ hiển thị ngay ở lượt tải trang kế tiếp."

msgid "added %d new strings"
msgstr "thêm %d chuỗi mới"

msgid "removed %d unused untranslated strings"
msgstr "gỡ %d chuỗi chưa dịch không còn dùng"

msgid "Interface scan complete: %1$s. There are now %2$d visitor-visible strings."
msgstr "Đã quét giao diện: %1$s. Hiện có %2$d chuỗi khách nhìn thấy."

msgid "The list is complete: all %d visitor-visible strings are already listed."
msgstr "Danh sách đã đầy đủ: %d chuỗi khách nhìn thấy đều đã có."

msgid "Translate posts, pages and interface text."
msgstr "Bản dịch bài viết, trang và chữ trên giao diện."

msgid "Enabled languages"
msgstr "Ngôn ngữ đang bật"

