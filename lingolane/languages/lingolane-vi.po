msgstr "Thêm ngôn ngữ thứ hai để bắt đầu dịch bài viết và giao diện."

msgid "Add a language"
msgstr "Thêm ngôn ngữ"

msgid "Post and page translation progress"
msgstr "Tiến độ dịch bài và trang"

