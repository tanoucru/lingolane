msgstr "Mở Cài đặt › Đường dẫn tĩnh"

msgid "Translation tables ready"
msgstr "Bảng dữ liệu bản dịch sẵn sàng"

msgid "Translation links and strings are stored separately and do not affect your original content."
msgstr "Liên kết bản dịch và chuỗi được lưu riêng, không ảnh hưởng nội dung gốc."

msgid "Missing tables"
msgstr "Thiếu bảng dữ liệu"

msgid "Deactivate and reactivate the plugin to create the tables."
msgstr "Tắt rồi bật lại plugin để tạo bảng."

msgid "Multilingual SEO"
msgstr "SEO đa ngôn ngữ"

msgid "hreflang, canonical and lang attributes are added automatically to pages that have translations."
msgstr "Thẻ hreflang, canonical và thuộc tính lang được thêm tự động cho trang có bản dịch."

msgid "Language-specific menus"
msgstr "Menu riêng theo ngôn ngữ"

