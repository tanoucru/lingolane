msgid "Scan frontend pages or your active theme to automatically discover translatable strings."
msgstr "Quét các trang frontend hoặc giao diện để tự động phát hiện các chuỗi có thể dịch."

msgid "Scan frontend pages to discover strings and positions"
msgstr "Quét các trang frontend để phát hiện chuỗi và vị trí"

msgid "Scan mode active..."
msgstr "Chế độ quét đang hoạt động..."

msgid "Scan pages"
msgstr "Quét trang"

msgid "Scan pages now"
msgstr "Quét trang ngay"

msgid "Scan session has expired or does not exist."
msgstr "Phiên quét đã hết hạn hoặc không tồn tại."

msgid "Scan theme"
msgstr "Quét giao diện"

msgid "Scanning page %1$d of %2$d: %3$s"
msgstr "Đang quét trang %1$d / %2$d: %3$s"

msgid "Scanning…"
msgstr "Đang quét…"

msgid "Search source or translation…"
msgstr "Tìm chuỗi gốc hoặc bản dịch…"

msgid "Security issue?"
msgstr "Vấn đề bảo mật?"

msgid "Select all discovered pages"
msgstr "Chọn tất cả các trang đã tìm thấy"

msgid "Select pages to scan. Lingolane will discover strings on these pages, map their exact locations, and check whether they can be translated automatically."
msgstr "Chọn các trang cần quét. Lingolane sẽ phát hiện các chuỗi trên các trang này, định vị chính xác và kiểm tra khả năng dịch tự động."

msgid "Session ceiling of maximum occurrences exceeded."
msgstr "Đã vượt quá số lượng vị trí tối đa cho phép trong phiên."

msgid "Session does not belong to the current user."
msgstr "Phiên quét không thuộc về người dùng hiện tại."

msgid "Site Info"
msgstr "Thông tin trang"

msgid "Source term cannot be modified through the translation tool."
msgstr "Không thể chỉnh sửa term gốc qua công cụ dịch."

msgid "Source term does not belong to the default language."
msgstr "Term gốc không thuộc về ngôn ngữ mặc định."

msgid "Source term not found."
msgstr "Không tìm thấy term gốc."

msgid "Start scan"
msgstr "Bắt đầu quét"

msgid "Steps to reproduce"
msgstr "Các bước tái hiện"

msgid "String location groups"
msgstr "Các nhóm vị trí chuỗi"

msgid "Summary"
msgstr "Tóm tắt"

msgid "Support"
msgstr "Hỗ trợ"

msgid "Support channels"
msgstr "Kênh hỗ trợ"

msgid "Support forum on WordPress.org"
msgstr "Diễn đàn hỗ trợ trên WordPress.org"

msgid "Support is given by volunteers in the public forum. Please do not post passwords or private data."
msgstr "Hỗ trợ được thực hiện bởi các tình nguyện viên trên diễn đàn công khai. Vui lòng không đăng mật khẩu hoặc dữ liệu riêng tư."

msgid "System report"
msgstr "Báo cáo hệ thống"

msgid "Target language:"
msgstr "Ngôn ngữ đích:"

msgid "Taxonomy Terms:"
msgstr "Thuật ngữ phân loại:"

msgid "Taxonomy is not supported or not public."
msgstr "Taxonomy không được hỗ trợ hoặc không công khai."

msgid "Term name"
msgstr "Tên thuật ngữ"

msgid "Term name cannot be empty."
msgstr "Tên term không được để trống."

msgid "Term translation saved."
msgstr "Đã lưu bản dịch term."

msgid "Text no longer found. Scan this page again."
msgstr "Không còn tìm thấy văn bản trên trang. Hãy quét lại trang này."

msgid "The forum is public. Leave this empty if the address should stay private."
msgstr "Diễn đàn là công khai. Hãy để trống nếu muốn giữ kín địa chỉ website."

msgid "Theme"
msgstr "Giao diện"

msgid "Ticket preview"
msgstr "Xem trước yêu cầu"

msgid "Title"
msgstr "Tiêu đề"

msgid "Topic"
msgstr "Chủ đề"

msgid "Translations are cached; clearing makes the site read them again."
msgstr "Bản dịch được lưu đệm; xoá cache sẽ buộc website đọc lại từ đầu."

msgid "Unknown string source provider."
msgstr "Nguồn cung cấp chuỗi không xác định."

msgid "Unsupported"
msgstr "Chưa hỗ trợ"

msgid "Update to the latest version"
msgstr "Cập nhật phiên bản mới nhất"

msgid "Using a separate menu for this language. Translations entered here apply to the shared menu."
msgstr "Đang dùng menu riêng cho ngôn ngữ này. Bản dịch nhập tại đây chỉ áp dụng cho menu dùng chung."

msgid "What did you expect?"
msgstr "Bạn mong đợi điều gì?"

msgid "What happened"
msgstr "Điều gì đã xảy ra"

msgid "What happened?"
msgstr "Điều gì đã xảy ra?"

msgid "Widgets"
msgstr "Widget"

msgid "Write your ticket"
msgstr "Soạn yêu cầu hỗ trợ"

msgid "Xem vị trí"
msgstr "Xem vị trí"

msgid "You are running Lingolane %s. The problem may already be fixed."
msgstr "Bạn đang chạy Lingolane %s. Vấn đề có thể đã được khắc phục ở bản mới."

msgid "You do not have permission to delete strings."
msgstr "Bạn không có quyền xoá chuỗi."

msgid "You do not have permission to edit translations."
msgstr "Bạn không có quyền chỉnh sửa bản dịch."

msgid "You do not have permission to preview strings."
msgstr "Bạn không có quyền xem trước chuỗi."

msgid "You do not have permission to start a scan session."
msgstr "Bạn không có quyền bắt đầu phiên quét."

msgid "You have unsaved translations. Leave anyway?"
msgstr "Bạn có bản dịch chưa lưu. Vẫn muốn rời đi?"

msgid "https://github.com/tanoucru"
msgstr "https://github.com/tanoucru"

msgid "https://github.com/tanoucru/lingolane"
msgstr "https://github.com/tanoucru/lingolane"
