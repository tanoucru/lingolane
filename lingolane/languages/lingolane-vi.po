msgid "Select language"
msgstr "Chọn ngôn ngữ"

msgid "Languages that have a translation of the current page."
msgstr "Danh sách ngôn ngữ có bản dịch cho trang hiện tại."

msgid "Invalid string data."
msgstr "Dữ liệu chuỗi không hợp lệ."

msgid "The source string must be valid UTF-8 text."
msgstr "Chuỗi gốc phải là văn bản UTF-8 hợp lệ."

msgid "Domain and source string cannot be empty; domain and context are limited to 100 characters."
msgstr "Miền và chuỗi gốc không được để trống; miền và ngữ cảnh tối đa 100 ký tự."

msgid "Could not save the string translation."
msgstr "Không thể lưu chuỗi dịch."

msgid "Invalid element or language."
msgstr "Phần tử hoặc ngôn ngữ không hợp lệ."

msgid "Could not lock the translation group. Please try again."
msgstr "Chưa thể khóa nhóm bản dịch. Vui lòng thử lại."

msgid "The group already has a translation or belongs to a different content type."
msgstr "Nhóm đã có bản dịch hoặc khác loại nội dung."

msgid "Could not save the translation group."
msgstr "Không thể lưu nhóm bản dịch."

msgid "Invalid post ID or language."
msgstr "ID bài viết hoặc ngôn ngữ không hợp lệ."

msgid "The original post was not found."
msgstr "Không tìm thấy bài viết gốc."

msgid "The post is already in the target language."
msgstr "Bài viết đã thuộc ngôn ngữ đích."

msgid "Draft translation created."
msgstr "Đã tạo bản dịch nháp."

msgid "Content, images and terms were copied from the original. Translate the title, content and slug, then click Publish."
msgstr "Nội dung, ảnh và phân loại đã được sao chép từ bản gốc. Dịch tiêu đề, nội dung và đường dẫn rồi bấm Đăng."

msgid "Translations"
msgstr "Bản dịch"

msgid "Language of this post"
msgstr "Ngôn ngữ của bài này"

msgid "Original:"
msgstr "Bản gốc:"

msgid "Shared: this post is shown in every language. Only create a translation if you need separate content for each language."
msgstr "Đang dùng chung: bài này hiển thị ở mọi ngôn ngữ. Chỉ tạo bản dịch nếu cần nội dung riêng cho từng ngôn ngữ."

msgid "Create translation"
msgstr "Tạo bản dịch"

msgid "Save the post first"
msgstr "Lưu bài trước"

msgid "The language was not changed: this translation group already has a %s version. The post was saved with its previous language."
msgstr "Chưa đổi được ngôn ngữ: nhóm bản dịch này đã có bản %s. Bài đã được lưu với ngôn ngữ cũ."

msgid "You do not have permission to edit this content."
msgstr "Bạn không có quyền sửa nội dung này."

msgid "Invalid content or language."
msgstr "Nội dung hoặc ngôn ngữ không hợp lệ."

msgid "You do not have permission to create content of this type."
msgstr "Bạn không có quyền tạo nội dung loại này."

msgid "You do not have permission to edit this translation."
msgstr "Bạn không có quyền sửa bản dịch này."

msgid "You do not have permission to perform this action."
msgstr "Bạn không có quyền thực hiện thao tác này."

msgid "String deleted."
msgstr "Đã xoá chuỗi."

msgid "Translation saved."
msgstr "Đã lưu bản dịch."

msgid "Imported %1$d rows, then stopped: %2$s"
msgstr "Đã nhập %1$d dòng rồi dừng: %2$s"

msgid "Imported %d translations."
msgstr "Đã nhập %d bản dịch."

msgid "This string was not found. Reload the page and try again."
msgstr "Không tìm thấy chuỗi này. Tải lại trang rồi thử lại."

msgid "This string has already been deleted."
msgstr "Chuỗi này đã được xoá."

msgid "Your session has expired. Reload the page."
msgstr "Phiên làm việc đã hết hạn. Tải lại trang."

msgid "No CSV file selected."
msgstr "Chưa chọn file CSV."

msgid "The file upload failed. Please try again."
msgstr "Tải file lên không thành công. Thử lại."

msgid "Only .csv files up to 2 MB are accepted."
msgstr "Chỉ nhận file .csv tối đa 2 MB."

msgid "Could not read the CSV file."
msgstr "Không đọc được file CSV."

msgid "The CSV file is empty or has no header row."
msgstr "File CSV trống hoặc thiếu dòng tiêu đề."

msgid "The header row must contain these columns: %s. Nothing was written."
msgstr "Dòng tiêu đề phải gồm các cột: %s. Chưa có dữ liệu nào được ghi."

msgid "Row %d has a different number of columns than the header. Nothing was written."
msgstr "Dòng %d có số cột không khớp tiêu đề. Chưa có dữ liệu nào được ghi."

msgid "Row %d is not valid UTF-8 text. Save the file with UTF-8 encoding and try again."
msgstr "Dòng %d không phải văn bản UTF-8 hợp lệ. Lưu file với mã hoá UTF-8 rồi thử lại."

msgid "Row %d is missing the source string, or its language code is not enabled on this site. Nothing was written."
msgstr "Dòng %d thiếu chuỗi gốc hoặc mã ngôn ngữ không có trên website. Chưa có dữ liệu nào được ghi."

msgid "The file has no data rows."
msgstr "File không có dòng dữ liệu nào."

msgid "No language to translate into yet"
msgstr "Chưa có ngôn ngữ để dịch"

msgid "Add a second language in the Languages tab."
msgstr "Thêm ngôn ngữ thứ hai ở tab Ngôn ngữ."

msgid "All"
msgstr "Tất cả"

msgid "Untranslated"
msgstr "Chưa dịch"

msgid "Translated"
msgstr "Đã dịch"

msgid "Provided by theme"
msgstr "Giao diện có sẵn"

msgid "Interface strings · %s"
msgstr "Chữ trên giao diện · %s"

msgid "Scan interface"
msgstr "Quét giao diện"

msgid "Filter by status"
msgstr "Lọc theo tình trạng"

msgid "Translate into"
msgstr "Dịch sang"

msgid "Search"
msgstr "Tìm"

msgid "Source text or translation"
msgstr "Chữ gốc hoặc bản dịch"

msgid "Filter"
msgstr "Lọc"

msgid "Clear filters"
msgstr "Xoá bộ lọc"

msgid "Tip: type the translation, then press <kbd>Ctrl</kbd>/<kbd>⌘</kbd> + <kbd>Enter</kbd> to save and jump to the next string."
msgstr "Mẹo: gõ bản dịch rồi nhấn <kbd>Ctrl</kbd>/<kbd>⌘</kbd> + <kbd>Enter</kbd> để lưu và chuyển sang chuỗi kế tiếp."

msgid "%s translation"
msgstr "Bản dịch %s"

msgid "No untranslated strings left."
msgstr "Không còn chuỗi nào chưa dịch."

msgid "The list is empty. Click “Scan interface” to collect text from your theme, or import a CSV file below."
msgstr "Danh sách đang trống. Bấm “Quét giao diện” để lấy chữ từ theme, hoặc nhập file CSV bên dưới."

msgid "No strings match the filter."
msgstr "Không có chuỗi nào khớp bộ lọc."

msgid "Enter translation…"
msgstr "Nhập bản dịch…"

msgid "Edit the built-in translation"
msgstr "Sửa từ bản có sẵn"

msgid "For names, product codes and similar text that needs no translation"
msgstr "Dùng cho tên riêng, mã chương trình… không cần dịch"

msgid "Keep as is"
msgstr "Giữ nguyên"

msgid "Delete"
msgstr "Xoá"

msgid "Save"
msgstr "Lưu"

msgid "Bulk translate with CSV"
msgstr "Dịch hàng loạt bằng CSV"

msgid "Download all strings and existing translations, then open them in Google Sheets or Excel to translate."
msgstr "Tải toàn bộ chuỗi và bản dịch hiện có, mở bằng Google Sheets hoặc Excel để dịch."

msgid "Download CSV"
msgstr "Tải file CSV"

msgid "2. Import again"
msgstr "2. Nhập lại"

msgid "CSV file (UTF-8, up to 2 MB)"
msgstr "File CSV (UTF-8, tối đa 2 MB)"

msgid "Use the file exported in step 1 (columns domain, context, source, language, translation)."
msgstr "Dùng file đã xuất ở bước 1 (cột domain, context, source, language, translation)."

msgid "Import translations"
msgstr "Nhập bản dịch"

msgid "The file is validated before anything is written; if one row is invalid, no row is saved."
msgstr "File được kiểm tra trước khi ghi; nếu một dòng sai, không dòng nào bị ghi."

