msgstr "%1$s/%2$s có bản dịch"

msgid "Translate the %s missing pages"
msgstr "Dịch %s trang còn thiếu"

msgid "Publish %s drafts"
msgstr "Xuất bản %s bản nháp"

msgid "All posts & pages are translated"
msgstr "Bài & trang đã dịch đủ"

msgid "%s untranslated strings"
msgstr "%s chuỗi chưa dịch"

msgid "System status"
msgstr "Tình trạng hệ thống"

msgid "%s shared records are shown in every language and need no translation."
msgstr "%s bản ghi dùng chung cho mọi ngôn ngữ, không cần tạo bản dịch."

msgid "Language directory in URLs"
msgstr "Đường dẫn theo thư mục ngôn ngữ"

msgid "Example: /en/about-us/. The default language has no prefix."
msgstr "Ví dụ: /en/about-us/. Ngôn ngữ mặc định không có tiền tố."

msgid "Pretty permalinks required"
msgstr "Cần bật đường dẫn đẹp"

