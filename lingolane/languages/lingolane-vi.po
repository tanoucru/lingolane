msgid "Display name"
msgstr "Tên hiển thị"

msgid "Make %s the default language? Every page URL will change: this language loses its prefix and the current default gets one. Do this before search engines have indexed your site."
msgstr "Đặt %s làm ngôn ngữ mặc định? Địa chỉ của mọi trang sẽ đổi: ngôn ngữ này bỏ tiền tố, ngôn ngữ hiện tại nhận tiền tố. Nên làm trước khi website có lượt truy cập từ Google."

msgid "Set as default"
msgstr "Đặt mặc định"

msgid "Remove %s from the site? URLs for this language will stop working."
msgstr "Gỡ %s khỏi website? Đường dẫn của ngôn ngữ này sẽ ngừng hoạt động."

msgid "Has linked content; cannot remove"
msgstr "Còn nội dung liên kết, không thể gỡ"

