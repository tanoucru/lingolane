msgstr "Mã (dùng trong đường dẫn)"

msgid "2–3 lowercase letters, for example fr → /fr/"
msgstr "2–3 chữ cái thường, ví dụ fr → /fr/"

msgid "Content to translate"
msgstr "Nội dung cần dịch"

msgid "Selected types get a Language column in the post list, a “Translations” box in the editor, and are filtered by language on the front end."
msgstr "Loại được chọn có cột Ngôn ngữ trong danh sách bài, hộp “Bản dịch” trong trình soạn thảo và được lọc theo ngôn ngữ ngoài website."

msgid "Taxonomies"
msgstr "Phân loại"

msgid "“Shared”: records of shared types appear in every language until you create a separate translation for that record."
msgstr "“Dùng chung”: bản ghi thuộc loại dùng chung hiển thị ở mọi ngôn ngữ cho tới khi bạn tạo bản dịch riêng cho bản ghi đó."

msgid "When a translation is missing"
msgstr "Khi chưa có bản dịch"

msgid "Untranslated pages always open the original with a small notice for visitors and never return a 404 error."
msgstr "Trang chưa dịch luôn mở bản gốc kèm thông báo nhỏ cho khách, không bao giờ báo lỗi 404."

msgid "Show untranslated posts in lists"
msgstr "Hiện bài chưa dịch trong danh sách"

msgid "Blog, archive and search pages in other languages will also list original posts that have no translation. Turn off to list translated posts only."
msgstr "Trang blog, chuyên mục và tìm kiếm ở ngôn ngữ khác sẽ liệt kê cả bài gốc chưa có bản dịch. Tắt để chỉ liệt kê bài đã dịch."

msgid "Fixed text in themes and plugins (buttons, labels, messages). Translations entered in the Interface strings tab take priority over built-in ones."
msgstr "Chữ cố định trong theme và plugin (nút, nhãn, thông báo). Bản dịch nhập ở tab Chuỗi giao diện được ưu tiên hơn bản có sẵn."

msgid "Translate theme text"
msgstr "Dịch chữ của theme"

msgid "Apply saved translations to your active theme."
msgstr "Áp dụng bản dịch đã lưu cho theme đang dùng."

msgid "Translate plugin text"
msgstr "Dịch chữ của plugin"

msgid "Apply saved translations to forms and other plugins."
msgstr "Áp dụng bản dịch đã lưu cho form và các plugin khác."

msgid "Translate only these text domains"
msgstr "Chỉ dịch các miền (text domain)"

msgid "Leave empty = every domain with translations"
msgstr "Để trống = mọi miền có bản dịch"

msgid "Example: my-theme, my-plugin. Separate with commas. Leave empty if unsure."
msgstr "Ví dụ: my-theme, my-plugin. Phân cách bằng dấu phẩy. Để trống nếu không chắc."

msgid "Save settings"
msgstr "Lưu cài đặt"

msgid "Tools"
msgstr "Công cụ"

msgid "Use after updating your theme or importing translations in bulk."
msgstr "Dùng khi vừa cập nhật theme hoặc nhập bản dịch hàng loạt."

msgid "Find new strings in the theme"
msgstr "Tìm chuỗi mới trong giao diện"

msgid "Reads the theme code and adds new text to the list to translate. Existing translations are not changed."
msgstr "Đọc mã theme và thêm chữ mới vào danh sách cần dịch. Không thay đổi bản dịch đã có."

msgid "Clear cache"
msgstr "Làm mới bộ nhớ đệm"

msgid "Deletes temporary translation data so the site reads it again immediately."
msgstr "Xoá dữ liệu tạm của bản dịch để website đọc lại ngay."

msgid "Refresh"
msgstr "Làm mới"

msgid "Other, rarely used types (%d)"
msgstr "Loại khác ít dùng (%d)"

msgid "Guide contents"
msgstr "Mục lục hướng dẫn"

msgid "Translate a page"
msgstr "Dịch một trang"

msgid "Translate interface text"
msgstr "Dịch chữ trên giao diện"

msgid "Language-specific menus"
msgstr "Menu theo ngôn ngữ"

msgid "Language switcher"
msgstr "Nút chuyển ngôn ngữ"

msgid "Shared records"
msgstr "Hồ sơ dùng chung"

msgid "SEO and URLs"
msgstr "SEO và đường dẫn"

msgid "1. Translate a page or post"
msgstr "1. Dịch một trang hoặc bài viết"

msgid "Open the %s tab and find the page to translate (filter by “No published translation” to see what is left)."
msgstr "Mở tab %s, tìm trang cần dịch (lọc “Chưa có bản dịch xuất bản” để thấy việc còn lại)."

msgid "Click “Create translation” in the language column. A draft is created with all the content, images and terms of the original."
msgstr "Bấm “Tạo bản dịch” ở cột ngôn ngữ. Một bản nháp được tạo với toàn bộ nội dung, ảnh và phân loại của bản gốc."

msgid "Translate the title, content and slug in the editor, then click Publish."
msgstr "Dịch tiêu đề, nội dung và đường dẫn (slug) trong trình soạn thảo, sau đó bấm Đăng."

msgid "You can also do this in the editor: the “Translations” box in the right column shows the post’s language and buttons for missing translations. The Language column in the Pages/Posts lists has the same buttons."
msgstr "Cũng có thể làm ngay trong trình soạn thảo: hộp “Bản dịch” ở cột phải hiển thị ngôn ngữ của bài và nút tạo bản dịch còn thiếu. Cột Ngôn ngữ trong danh sách Trang/Bài viết cũng có nút tương tự."

msgid "2. Translate interface text"
msgstr "2. Dịch chữ trên giao diện"

msgid "Buttons, form labels and messages live in theme/plugin code, so they cannot be edited in the editor."
msgstr "Nút, nhãn form, thông báo… nằm trong mã theme/plugin nên không sửa trong trình soạn thảo được."

msgid "In the Interface strings tab, filter by “Untranslated”."
msgstr "Ở tab Chuỗi giao diện, lọc “Chưa dịch”."

msgid "Type the translation, then click Save or press Ctrl/⌘ + Enter (it moves to the next string)."
msgstr "Gõ bản dịch rồi bấm Lưu hoặc Ctrl/⌘ + Enter (tự chuyển sang chuỗi kế tiếp)."

msgid "Strings marked “Provided by theme” are already translated by the theme; only enter one to change the wording."
msgstr "Chuỗi “Giao diện có sẵn” đã được theme dịch; chỉ nhập khi muốn thay câu chữ."

msgid "Bulk translate: export CSV, edit in Google Sheets/Excel, then import again. Columns: domain, context, source, language, translation."
msgstr "Dịch hàng loạt: Xuất CSV, sửa trong Google Sheets/Excel, rồi Nhập lại. Cột: domain, context, source, language, translation."

msgid "3. Language-specific menus"
msgstr "3. Menu theo ngôn ngữ"

msgid "Create a new menu under Appearance › Menus and name it using the pattern <code>location language-code</code>, for example %1$s. When visitors view that language, this menu replaces the original at the matching location."
msgstr "Tạo menu mới ở Giao diện › Menu và đặt tên theo mẫu <code>vị-trí mã-ngôn-ngữ</code>, ví dụ %1$s. Khi khách xem bản tiếng đó, menu này tự thay menu gốc ở vị trí tương ứng."

msgid "Theme menu locations: %s"
msgstr "Vị trí menu của theme: %s"

msgid "4. Language switcher"
msgstr "4. Nút chuyển ngôn ngữ"

msgid "To place a language switcher anywhere:"
msgstr "Để đặt nút chuyển ngôn ngữ ở bất kỳ vị trí nào:"

msgid "Shortcode: <code>[lingolane_switcher]</code>, dropdown style <code>[lingolane_switcher style=\"dropdown\"]</code>, codes only <code>[lingolane_switcher show=\"code\"]</code>."
msgstr "Shortcode: <code>[lingolane_switcher]</code>, dạng thả xuống <code>[lingolane_switcher style=\"dropdown\"]</code>, chỉ hiện mã <code>[lingolane_switcher show=\"code\"]</code>."

msgid "Widget: Appearance › Widgets › “Select language”."
msgstr "Widget: Giao diện › Widget › “Chọn ngôn ngữ”."

msgid "In a menu: add a Custom Link with the URL <code>#lingolane-switcher</code> and the label <code>{{lingolane}}</code>; it expands into one item per language."
msgstr "Trong menu: thêm Liên kết tự tạo với URL <code>#lingolane-switcher</code> và nhãn <code>{{lingolane}}</code>; mục này tự tách thành từng ngôn ngữ."

msgid "The switcher always links to the matching translation of the current page; untranslated pages link to the original with a notice."
msgstr "Nút luôn dẫn tới đúng bản dịch của trang đang xem; trang chưa dịch dẫn về bản gốc kèm ghi chú."

msgid "5. Shared records and account pages"
msgstr "5. Bản ghi dùng chung và trang tài khoản"

msgid "Records of shared post types, shared taxonomies and shared pages (for example account and checkout pages) are shown in every language, so visitors in any language can still find them. Fixed text on those pages is translated through Interface strings; content written by users stays unchanged."
msgstr "Bản ghi của các loại nội dung, phân loại và trang dùng chung (ví dụ trang tài khoản, thanh toán) hiển thị ở mọi ngôn ngữ nên khách ở ngôn ngữ nào cũng tìm thấy. Chữ cố định trên các trang này được dịch qua Chuỗi giao diện; nội dung do người dùng viết giữ nguyên."

msgid "6. SEO and URLs"
msgstr "6. SEO và đường dẫn"

msgid "The default language has no prefix; other languages live in their own directory, for example %s."
msgstr "Ngôn ngữ mặc định không có tiền tố; ngôn ngữ khác nằm trong thư mục riêng, ví dụ %s."

msgid "Every translated page automatically gets hreflang, x-default and canonical tags in the right language; Yoast SEO uses the same values."
msgstr "Mỗi trang có bản dịch tự có thẻ hreflang, x-default và canonical đúng ngôn ngữ; Yoast SEO dùng chung các giá trị này."

msgid "Internal links inside content automatically switch to the matching translation when one exists."
msgstr "Liên kết nội bộ trong bài được tự chuyển sang bản dịch tương ứng khi có."

msgid "This post is written in %s"
msgstr "Bài này viết bằng %s"

msgid "Shown in every language"
msgstr "Hiển thị ở mọi ngôn ngữ"

msgid "Edit %1$s version (%2$s)"
msgstr "Sửa bản %1$s (%2$s)"

msgid "Create %s translation"
msgstr "Tạo bản dịch %s"

msgid "Filter by language"
msgstr "Lọc theo ngôn ngữ"

msgid "(opens in a new tab)"
msgstr "(mở tab mới)"

msgid "Edit"
msgstr "Sửa"

msgid "Source"
msgstr "Nguồn"

msgid "Source text (%s)"
msgstr "Chữ gốc (%s)"

msgid "1. Export file"
msgstr "1. Xuất file"

msgid "Overview"
msgstr "Tổng quan"

msgid "Interface strings"
msgstr "Chuỗi giao diện"

msgid "Pending review"
msgstr "Chờ duyệt"

msgid "%s provided by the theme"
msgstr "%s lấy từ giao diện"

msgid "Original content"
msgstr "Nội dung gốc"

msgid "Remove"
msgstr "Gỡ"

msgid "Content"
msgstr "Nội dung"

msgid "Next"
msgstr "Sau"

msgid "View page"
msgstr "Xem trang"

msgid "view side by side"
msgstr "xem song song"

msgid "WordPress locale"
msgstr "Locale WordPress"

msgid "Lightweight multilingual for WordPress: translation groups for posts and pages, string translation, language URLs, hreflang and a language switcher."
msgstr "Đa ngôn ngữ nhẹ cho WordPress: nhóm bản dịch cho bài viết và trang, dịch chuỗi giao diện, đường dẫn theo ngôn ngữ, hreflang và nút chuyển ngôn ngữ."

msgid "Locale"
msgstr "Locale"

msgid "Built in"
msgstr "Có sẵn"

msgid "Download"
msgstr "Tải về"

msgid "Downloaded the WordPress, theme and plugin translations available for %s."
msgstr "Đã tải các bản dịch WordPress, theme và plugin hiện có cho %s."

msgid "Installed"
msgstr "Đã cài"

msgid "Language"
msgstr "Ngôn ngữ"

msgid "Not installed"
msgstr "Chưa cài"

msgid "Pick a language to prefill, or type your own. Only the translations of the languages you add are downloaded from WordPress.org (WordPress, themes and plugins). After adding, create translations for each page in the Posts & pages tab."
msgstr "Chọn một ngôn ngữ để điền sẵn, hoặc tự nhập. Chỉ bản dịch của các ngôn ngữ bạn thêm mới được tải từ WordPress.org (WordPress, theme và plugin). Sau khi thêm, hãy tạo bản dịch cho từng trang ở thẻ Bài & trang."

msgid "Popular"
msgstr "Phổ biến"

msgid "Translations for %1$s were not downloaded: %2$s"
msgstr "Chưa tải được bản dịch cho %1$s: %2$s"

msgid "Update"
msgstr "Cập nhật"

msgid "WordPress cannot write translation files on this server (file permissions or DISALLOW_FILE_MODS). Translations will be installed by the next automatic update if possible, or from Dashboard > Updates."
msgstr "WordPress không ghi được tệp bản dịch trên máy chủ này (quyền tệp hoặc DISALLOW_FILE_MODS). Bản dịch sẽ được cài ở lần cập nhật tự động tới nếu có thể, hoặc từ Bảng tin > Cập nhật."

msgid "WordPress is written in English; nothing to download"
msgstr "WordPress viết bằng tiếng Anh, không cần tải"

msgid "WordPress, theme and plugin text shows in English for this language"
msgstr "Chữ của WordPress, theme và plugin đang hiện bằng tiếng Anh ở ngôn ngữ này"

msgid "WordPress.org has no translation for %s, or it could not be downloaded. Check the locale or try again later."
msgstr "WordPress.org không có bản dịch cho %s, hoặc không tải được. Hãy kiểm tra locale hoặc thử lại sau."

msgid "Your account cannot install translations. An administrator can install them in Dashboard > Updates."
msgstr "Tài khoản của bạn không được cài bản dịch. Quản trị viên có thể cài ở Bảng tin > Cập nhật."

msgid "Notifications"
msgstr "Thông báo"

msgid "Dismiss notification"
msgstr "Đóng thông báo"

msgid "Everything is translated"
msgstr "Đã dịch xong tất cả"

msgid "Every page and interface string is published in all your languages. New content will show up here when it needs translating."
msgstr "Mọi trang và chuỗi giao diện đã có ở tất cả ngôn ngữ của bạn. Nội dung mới cần dịch sẽ hiện ở đây."

msgid "Add another language"
msgstr "Thêm ngôn ngữ khác"

msgid "Welcome to Lingolane"
msgstr "Chào mừng bạn đến với Lingolane"

msgid "Translate pages, menus and interface text in a few steps. Start with the guide below or add your languages first."
msgstr "Dịch trang, menu và chữ giao diện chỉ trong vài bước. Bắt đầu với phần hướng dẫn bên dưới, hoặc thêm ngôn ngữ trước."

msgid "Set up languages"
msgstr "Thiết lập ngôn ngữ"
